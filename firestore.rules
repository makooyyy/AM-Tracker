rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything the app stores lives in users/{uid}/items/*.
    // A signed-in user can only touch their own documents.
    match /users/{uid}/items/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind', 'id', 'json', 'deleted', 'updatedAt', 'epoch', 'srv'])
        && request.resource.data.kind in ['t', 'awards', 'progress', 'log']
        && request.resource.data.id is string
        && request.resource.data.json is string
        && request.resource.data.json.size() < 500000
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt is number
        && request.resource.data.epoch is number
        && request.resource.data.srv == request.time;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
